---
import Base from '../../layouts/Base.astro';
import {
  t,
  CATEGORIES,
  CATEGORY_LABELS,
  langFromPath,
  alternatePath,
  formatDate,
} from '../../i18n';
import { getPostFamilies, postForLang, postUrl, familyCategory } from '../../lib/posts';

export async function getStaticPaths() {
  return CATEGORIES['zh-CN'].map((c) => ({
    params: { category: c.key },
  }));
}

const { category } = Astro.params;
const lang = langFromPath(Astro.url.pathname);
const d = t(lang);
const label = CATEGORY_LABELS[lang][category] ?? category;

const families = (await getPostFamilies()).filter((f) => familyCategory(f) === category);
---

<Base title={label} description={d.categoryDesc(label)} lang={lang}>
  <section class="hero" style="padding-bottom: 16px;">
    <h1>{label}</h1>
    <p>{d.articlesCount(families.length)}</p>
  </section>

  <ul class="post-list">
    {families.map((fam) => {
      const post = postForLang(fam, lang);
      return (
        <li class="post-item">
          <h2><a href={postUrl(fam, lang)}>{post.data.title}</a></h2>
          <p class="meta"><span>{formatDate(post.data.date, lang)}</span></p>
          <p class="desc">{post.data.description}</p>
        </li>
      );
    })}
    {families.length === 0 && <li class="post-item"><p class="desc">{d.noArticles}</p></li>}
  </ul>
</Base>
