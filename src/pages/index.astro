---
import Base from '../layouts/Base.astro';
import {
  t,
  CATEGORIES,
  CATEGORY_LABELS,
  langFromPath,
  alternatePath,
  formatDate,
} from '../i18n';
import { getPostFamilies, postForLang, postUrl, familyCategory } from '../lib/posts';

const lang = langFromPath(Astro.url.pathname);
const d = t(lang);
const families = await getPostFamilies();
---

<Base lang={lang}>
  <section class="hero">
    <h1>{d.tagline}</h1>
    <p>{d.description}</p>
    <ul class="chips">
      {CATEGORIES[lang].map((c) => (
        <li><a href={alternatePath(`/category/${c.key}/`, lang)}>{c.label}</a></li>
      ))}
    </ul>
  </section>

  <div class="section-title">{d.latestArticles}</div>
  <ul class="post-list">
    {families.map((fam) => {
      const post = postForLang(fam, lang);
      return (
        <li class="post-item">
          <h2><a href={postUrl(fam, lang)}>{post.data.title}</a></h2>
          <p class="meta">
            <span>{formatDate(post.data.date, lang)}</span>
            <span>·</span>
            <span>{CATEGORY_LABELS[lang][familyCategory(fam)]}</span>
          </p>
          <p class="desc">{post.data.description}</p>
        </li>
      );
    })}
  </ul>
</Base>
