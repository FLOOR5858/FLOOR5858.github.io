---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORIES, CATEGORY_LABELS } from '../consts';

const posts = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---

<Base>
  <section class="hero">
    <h1>{SITE.tagline}</h1>
    <p>{SITE.description}</p>
    <ul class="chips">
      {CATEGORIES.map((c) => (
        <li><a href={`/category/${c.key}/`}>{c.label}</a></li>
      ))}
    </ul>
  </section>

  <div class="section-title">最新文章</div>
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <h2><a href={`/articles/${post.id}/`}>{post.data.title}</a></h2>
        <p class="meta">
          <span>{fmt(post.data.date)}</span>
          <span>·</span>
          <span>{CATEGORY_LABELS[post.data.category]}</span>
        </p>
        <p class="desc">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
